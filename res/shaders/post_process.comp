#version 450
layout(local_size_x = 8, local_size_y = 8) in;

layout(constant_id = 0) const int SAMPLES = 4;
layout(set = 0, binding = 0) uniform texture2DMS hdr_msaa;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D out_img;
layout(push_constant) uniform PC { float exposure; } pc;

// ACES approximation (Narkowicz)
vec3 tonemap_aces(vec3 x) {
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Khronos PBR Neutral: keeps base colours intact, good for stylised/toon looks
vec3 tonemap_neutral(vec3 color) {
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;
    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;
    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) return color;
    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;
    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, vec3(newPeak), g);
}

vec3 linear_to_srgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(out_img)))) return;

    vec3 acc = vec3(0.0);
    for (int i = 0; i < SAMPLES; i++) {
        vec3 c = texelFetch(hdr_msaa, p, i).rgb * pc.exposure;
        acc += tonemap_neutral(c);       // tone map per sample...
    }
    acc /= float(SAMPLES);               // ...then average
    imageStore(out_img, p, vec4(linear_to_srgb(acc), 1.0));
}